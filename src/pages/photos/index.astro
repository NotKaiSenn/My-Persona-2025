---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { photoUrl } from '../../lib/collections';
import { photos } from '../../lib/photos';
import { displayDate } from '../../lib/post-data';
---
<SiteLayout title="照片" wide>
  <header class="page-heading"><h1>照片</h1></header>
  {photos.length > 0 ? <ul class="photo-list">{photos.map(photo => <li>
    <a class="photo-entry" href={photoUrl(photo)}>
      <div class="photo-frame"><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" /></div>
      <div class="photo-caption"><time datetime={photo.date}>{displayDate(new Date(`${photo.date}T00:00:00Z`))}</time><h2>{photo.title}</h2></div>
    </a>
  </li>)}</ul> : <div class="empty-state"><p>暂无照片</p></div>}
</SiteLayout>
<style>
  .photo-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 32px 24px; padding: 0; margin: 0; list-style: none; }
  .photo-list li { min-width: 0; }
  .photo-entry { display: block; border-radius: 12px; }
  .photo-frame { padding: 7px; border-radius: 12px; background: #fff; box-shadow: var(--surface-edge-shadow); }
  .photo-frame img { width: 100%; height: auto; border-radius: 6px; }
  .photo-caption { padding: 12px 2px 0; }
  time { display: block; color: var(--muted); font-size: .75rem; line-height: 1.5; }
  h2 { margin-top: 4px; font-size: .9375rem; line-height: 1.6; font-weight: 550; overflow-wrap: anywhere; }
  @media (max-width: 479px) {
    .photo-list { gap: 24px 14px; }
    .photo-frame { padding: 5px; border-radius: 10px; }
    .photo-frame img { border-radius: 5px; }
    .photo-caption { padding-top: 10px; }
    time { font-size: .6875rem; }
    h2 { font-size: .8125rem; }
  }
</style>
