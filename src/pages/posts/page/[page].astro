---
import type { GetStaticPaths } from 'astro';
import PostsPage from '../../../components/PostsPage.astro';
import { getPosts } from '../../../lib/posts';
import { PAGE_SIZE } from '../../../lib/post-data';
export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const count = Math.ceil(posts.length / PAGE_SIZE);
  return Array.from({ length: Math.max(0, count - 1) }, (_, i) => ({
    params: { page: String(i + 2) }, props: { posts, page: i + 2 },
  }));
}) satisfies GetStaticPaths;
---
<PostsPage {...Astro.props} />
