---
import { Icon } from 'astro-icon/components';
import WorkVisual from './WorkVisual.astro';
interface Props {
  title: string; href: string; kind: 'note' | 'photo' | 'friend'; index: number; total: number;
  paragraphs?: string[]; date?: Date; imageSrc?: string;
  imageWidth?: number; imageHeight?: number; imageAlt?: string; description?: string; showTitle?: boolean; iconSrc?: string;
}
const { title, href, kind, index, total, paragraphs = [], date, imageSrc, imageWidth, imageHeight, imageAlt = '', description, showTitle = false, iconSrc } = Astro.props;
const shapes = {
  note: [
    { width: 33, top: 3, ratio: 3 / 4.6 },
    { width: 36, top: 10, ratio: 3 / 3.8 },
    { width: 32, top: 1, ratio: 3 / 5 },
    { width: 35, top: 12, ratio: 3 / 4.2 },
  ],
  photo: [
    { width: 34, top: 5 }, { width: 44, top: 9 }, { width: 37, top: 4 },
    { width: 42, top: 10 }, { width: 32, top: 6 },
  ],
  friend: [
    { width: 36, top: 6 }, { width: 40, top: 10 },
    { width: 34, top: 4 }, { width: 38, top: 12 },
  ],
};
const shape = shapes[kind][index % shapes[kind].length];
const width = shape.width;
const imageRatio = (imageWidth ?? 4) / (imageHeight ?? 3);
const ratio = 'ratio' in shape ? shape.ratio : kind === 'friend' ? 1.35 : showTitle ? imageRatio : 1 / (.94 / imageRatio + .06);
const top = kind === 'photo' ? Math.max(shape.top, 40 - width / ratio * 20 / 17) : shape.top;
const offset = index - (total - 1) / 2;
const rotation = offset * (6 / Math.max(total - 1, 1));
const noteColors = ['#D5836D', '#7DA181', '#DAB55B', '#608EC9'];
const noteColorIndex = Array.from(href).reduce((hash, character) => (Math.imul(hash, 31) + character.codePointAt(0)!) >>> 0, 0) % noteColors.length;
const noteColor = noteColors[noteColorIndex];
---
<li class="folder-item" data-kind={kind === 'friend' ? 'photo' : kind} data-layout={kind} data-title={title} data-href={href} data-card-width={width} data-ratio={ratio} style={`--card-width:${width}%;--card-ratio:${ratio};--home-x:${offset * 6 / width * 100}%;--home-turn:${rotation}deg;--top:${top}%;z-index:${total - Math.round(Math.abs(offset))}`}>
  <div class="collection-frame">
    <a class="card-content" href={href} aria-label={title}>
      {kind === 'photo' && showTitle ? <WorkVisual image={imageSrc} icon={iconSrc} title={title} description={description} /> : kind === 'photo' ? <figure class="photo-print">
        <img src={imageSrc} alt={imageAlt} width={imageWidth} height={imageHeight} loading="lazy" decoding="async" />
      </figure> : kind === 'note' ? <article class="note-preview">
        <div class="excerpt-text">{paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
        <header class="note-caption" style={`--note-color:${noteColor}`}><h3>{title}</h3>{date && <time datetime={date.toISOString()}>{date.toISOString().slice(0,10).replaceAll('-',' / ')}</time>}</header>
      </article> : <article class="friend-preview">
        {imageSrc ? <img class="friend-avatar" src={imageSrc} alt="" width="64" height="64" loading="lazy" /> : <span class="friend-initial" aria-hidden="true">{title.slice(0,1)}</span>}
        <h3>{title}</h3>{description && <p>{description}</p>}<span class="friend-address"><span>{new URL(href).hostname}</span><Icon is:inline aria-hidden="true" focusable="false" name="ph:arrow-up-right" /></span>
      </article>}
    </a>
    <button class="card-picker" type="button" aria-label={`选择：${title}`} tabindex="-1"></button>
  </div>
</li>
<style is:global>
  .folder-item { position: absolute; left: 50%; top: var(--top); width: var(--card-width); aspect-ratio: var(--card-ratio); margin-left: calc(var(--card-width) / -2); transform: translateX(var(--home-x)) rotate(var(--home-turn)); transform-origin: center; list-style: none; }
  .collection-frame { position: relative; width: 100%; height: 100%; container-type: inline-size; --radius: 9cqw; }
  .card-content { display: block; width: 100%; height: 100%; overflow: hidden; border-radius: var(--radius); color: var(--ink); box-shadow: 0 0 0 1px #323b2f0a,0 2px 4px #2932280f,0 8px 16px #2932281f; -webkit-tap-highlight-color: transparent; }
  .card-content:hover { color: var(--ink); }
  .photo-print, .note-preview, .friend-preview { width: 100%; height: 100%; margin: 0; border-radius: var(--radius); overflow: hidden; }
  .photo-print { padding: 3cqw; background: white; }
  .photo-print img { width: 100%; height: 100%; object-fit: contain; border-radius: calc(var(--radius) - 3cqw); }
  .folder-item[data-kind="note"] .card-content { overflow: visible; box-shadow: none; }
  .note-preview { position: relative; display: grid; grid-template-rows: minmax(0,1fr) auto 15%; padding: 0; overflow: visible; border-radius: 0; background: none; }
  .note-preview::before { content: ''; position: absolute; inset: 0 0 0 8%; border-radius: var(--radius); background: #fffefa; box-shadow: 0 0 0 1px #323b2f08,0 2px 4px #2932280c,0 8px 16px #29322816; }
  .excerpt-text { position: relative; grid-row: 1; min-height: 0; margin-left: 8%; padding: 6cqw 6cqw 4cqw; font-size: 4.1cqw; line-height: 1.9; color: #62665a; overflow: hidden; overflow-wrap: anywhere; }
  .excerpt-text p + p { margin-top: 4cqw; }
  .note-caption { position: relative; grid-row: 2; margin-right: 12%; padding: 6cqw 4cqw; border-radius: 0 2cqw 2cqw 0; background: var(--note-color); color: #20251f; box-shadow: var(--surface-edge-shadow); }
  .note-caption time { display: block; margin-top: 4cqw; font: 3cqw/1.4 ui-monospace,monospace; letter-spacing: .04em; }
  .note-caption h3 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; font-size: 6.3cqw; font-weight: 550; line-height: 1.45; letter-spacing: -.015em; overflow-wrap: anywhere; }
  .friend-preview { padding: 9cqw; background: #fffefa; }
  .friend-avatar,.friend-initial { display: grid; place-items: center; width: 17cqw; height: 17cqw; border-radius: 50%; background: #e7ecdf; font-size: 8cqw; object-fit: cover; }
  .friend-preview h3 { margin-top: 5cqw; font-size: 7cqw; line-height: 1.4; overflow-wrap: anywhere; }
  .friend-preview p { margin-top: 2cqw; font-size: 4cqw; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .friend-preview .friend-address { display: flex; align-items: center; gap: .3em; margin-top: 4cqw; font-size: 3.5cqw; line-height: 1.5; color: var(--muted); overflow-wrap: anywhere; }
  .friend-preview .friend-address > span { min-width: 0; }
  .card-picker { display: none; }
  .folder-stage .folder-item { position: absolute; left: 0; top: 0; margin: 0; }
  .folder-stage .collection-frame { --radius: 3.5cqw; }
  .folder-stage .card-picker { display: block; position: absolute; inset: 0; width: 100%; border: none; border-radius: 3.5cqw; background: transparent; cursor: pointer; }
  .folder-stage .folder-item.is-active .card-picker { display: none; }
  .folder-stage .folder-item:not(.is-active) .card-content { pointer-events: none; }
  .folder-stage .card-content:focus-visible { outline-width: calc(2px / var(--stage-scale,1)); outline-offset: calc(4px / var(--stage-scale,1)); border-radius: var(--radius); }
</style>
