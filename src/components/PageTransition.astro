---
import { ClientRouter } from 'astro:transitions';
---
<ClientRouter fallback="swap" />
<style is:inline>
  main { view-transition-name: page-content; }
  ::view-transition { pointer-events: none; }
  ::view-transition-group(*) { animation: none; }
  ::view-transition-old(*), ::view-transition-new(*) {
    animation: none;
    mix-blend-mode: normal;
    opacity: 1;
  }
  ::view-transition-old(*) { display: none; }
  ::view-transition-image-pair(page-content) { isolation: isolate; }
  ::view-transition-old(page-content), ::view-transition-new(page-content) { mix-blend-mode: plus-lighter; }
  ::view-transition-old(page-content) { display: block; animation: 180ms ease-out both content-leave; }
  ::view-transition-new(page-content) { animation: 180ms ease-out both content-enter; }
  @keyframes content-leave { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(-5px); } }
  @keyframes content-enter { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; }
    ::view-transition-old(page-content) { display: none; }
  }
</style>
