---
interface Props {
  items?: Array<{ label: string; href?: string }>;
}
const { items = [] } = Astro.props;
---
<nav class="breadcrumbs" aria-label="当前位置">
  <ol>
    <li><a href="/" aria-current={items.length ? undefined : 'page'}>首页</a></li>
    {items.map((item, index) => <li>
      <span class="breadcrumb-separator" aria-hidden="true">/</span>
      {index === items.length - 1
        ? <span class="breadcrumb-current" aria-current="page" title={item.label}>{item.label}</span>
        : <a href={item.href}>{item.label}</a>}
    </li>)}
  </ol>
</nav>
<style>
  .breadcrumbs { min-width: 0; font-size: inherit; line-height: 1.5; }
  ol { display: flex; align-items: center; gap: 8px; min-width: 0; padding: 0; margin: 0; list-style: none; }
  li { display: flex; align-items: center; gap: 8px; min-height: 36px; flex-shrink: 0; }
  li:last-child { min-width: 0; flex-shrink: 1; }
  a { display: inline-flex; align-items: center; min-height: 36px; color: var(--muted, inherit); white-space: nowrap; text-decoration: none; }
  a:hover { color: var(--ink, inherit); }
  .breadcrumb-separator { color: currentColor; opacity: .3; flex-shrink: 0; }
  .breadcrumb-current { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--body, inherit); }
</style>
