---
import WorkVisual from './WorkVisual.astro';
import type { Work } from '../lib/collections';
interface Props { work: Work; }
const { work } = Astro.props;
---
<a class="work-print" href={work.url} aria-label={work.title}><WorkVisual title={work.title} image={work.image} description={work.description} /></a>
<style>
  .work-print { display: block; container-type: inline-size; --radius: 3.5cqw; border-radius: 12px; }
  .work-print :global(.work-visual) { box-shadow: 0 0 0 1px #323b2f0a,0 2px 4px #2932280f,0 8px 16px #29322816; }
</style>
